        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2y7BzlL0ipR6iuv0u7F2-1" value="Storage Queue" style="verticalLabelPosition=bottom;html=1;verticalAlign=top;align=center;strokeColor=none;fillColor=#00BEF2;shape=mxgraph.azure.storage_queue;" parent="1" vertex="1">
          <mxGeometry x="220" y="140" width="50" height="45" as="geometry" />
        </mxCell>
        <mxCell id="2y7BzlL0ipR6iuv0u7F2-2" value="Service bus" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/integration/Service_Bus.svg;" parent="1" vertex="1">
          <mxGeometry x="380" y="132.5" width="68" height="60" as="geometry" />
        </mxCell>
        <mxCell id="Eosnxq4khN18TS5ePxHE-1" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Pregunta&lt;/b&gt;: Tu aplicacion utiliza una cola de Service Bus para recibir mensajes de una aplicacion externa, y tienes varias aplicaciones que procesan esos mensajes.&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Problema&lt;/b&gt;: algunos mensajes, en circunstancias inusuales, se procesan 2 veces.¿Que haces para asegurarte de que los mensajes no se procesen dos veces, incluso si a veces no se procesan?&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Respuesta&lt;/b&gt;: Switch the queue to &quot;at-most-once&quot; delivery&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="140" y="240" width="440" height="140" as="geometry" />
        </mxCell>
        <mxCell id="Eosnxq4khN18TS5ePxHE-2" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Pregunta&lt;/b&gt;: ¿Cual de los siguientes lenguajes de programacion no es compatible con Web Jobs?&lt;/font&gt;&lt;div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Respuesta&lt;/b&gt;: Ruby&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="130" y="390" width="440" height="90" as="geometry" />
        </mxCell>
      </root>
