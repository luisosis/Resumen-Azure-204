        <mxCell id="ayEJXom1bwGqx5jgzHb6-1" value="" style="shape=image;verticalLabelPosition=bottom;labelBackgroundColor=default;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/png,;" parent="1" vertex="1">
          <mxGeometry x="210" y="740" width="478" height="171" as="geometry" />
        </mxCell>
        <mxCell id="ayEJXom1bwGqx5jgzHb6-2" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;HTTP trigger function&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="320" y="710" width="240" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ayEJXom1bwGqx5jgzHb6-3" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Function&lt;/b&gt;:&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;- &lt;b&gt;index.js:&lt;/b&gt; codigo que ejecutar la funcion en si.&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;- function.json&lt;/b&gt;: Configuracion de la funcion almacena en un archivo.&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="210" y="960" width="457" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ayEJXom1bwGqx5jgzHb6-4" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Function&lt;/b&gt;&lt;/font&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Template: timer trigger&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;schedule: 0 * / 5 * * * *&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&amp;nbsp; &amp;nbsp;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;(min)(hour)(diadelmes)(mes)(diadela semana)&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;0: Se ejecutara en el segundo &#39;cero&#39; (0) , no en el 1&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;*/5: Cada 5 minutos&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;* : cualquier hora&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;* : cualquier dia del mes&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;* : cualquier mes del año&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;* : cualquier dia de la semana.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="143.5" y="1060" width="590" height="230" as="geometry" />
        </mxCell>
        <mxCell id="Og30Mi_DR7OrBe_4aqla-1" value="Function core tool" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
          <mxGeometry x="143.5" y="1320" width="200" height="30" as="geometry" />
        </mxCell>
        <mxCell id="7n8mRDT8gF10-spiPjxP-1" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Pregunta&lt;/b&gt;: Desarrollaste&amp;nbsp; un logic app que llama una API pero el problema es que el logic app se descoenecta despues de 120 segundos por que la API tarda demasiado en responder ¿Cual es la modificacion adecuada para que esto funcione?&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Respuesta&lt;/b&gt;: Modificarlo a una solicitud asincrona.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="134" y="1400" width="446" height="110" as="geometry" />
        </mxCell>
        <mxCell id="7n8mRDT8gF10-spiPjxP-2" value="&lt;div style=&quot;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Pregunta&lt;/b&gt;: Puede activar manualmente una aplicacion logica implementada en Azure desde Visual Studio.&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Respuesta&lt;/b&gt;: Verdadero.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="134" y="1530" width="466" height="100" as="geometry" />
