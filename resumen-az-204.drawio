        <mxCell id="YcttL-3btu1ARh15kIzg-6" value="&lt;b&gt;Create a Cosmosdb Collection(Table)&lt;/b&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;RU/s: Request Units per second&lt;/div&gt;&lt;div&gt;A read of a 1KB document uses 1 RU.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;ID (unique)&lt;/div&gt;&lt;div&gt;partition key&amp;nbsp;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=14;" parent="1" vertex="1">
