        <mxCell id="SX1TlgFTNWWD1te53KMa-2" value="&lt;b&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;Azure Event Grid&lt;/font&gt;&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" parent="1" vertex="1">
