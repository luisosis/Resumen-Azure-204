<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36" version="27.1.1" pages="12">
  <diagram name="Azure App Service" id="nc_304IvwbxEuenFvEbK">
    <mxGraphModel dx="872" dy="1608" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ADoshxT2YIL1uXRaaqMh-1" value="" style="whiteSpace=wrap;html=1;aspect=fixed;" vertex="1" parent="1">
          <mxGeometry x="190" y="90" width="80" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ADoshxT2YIL1uXRaaqMh-2" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/app_services/App_Services.svg;" vertex="1" parent="1">
          <mxGeometry x="196" y="96" width="68" height="68" as="geometry" />
        </mxCell>
        <mxCell id="ADoshxT2YIL1uXRaaqMh-3" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;1.- Create azure web app.&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;2.- App service plan&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;3.- App service deployment options&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;4.- Manual Scalig an App Service&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;5.- Publishing an App Service.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;6.- Deploment Slots (Staging - Produccion)&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;7.- Add a custom Domain to An app service.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;8.- App service SSL Settings&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;9.- Enable Diagnostic Logs&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;font-size: 14px;&quot;&gt;10.- Create web app in poweshell:Consta de 2 componentes, creacion de un plan de servicio de aplicaciones y la aplicacion web.&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="30" y="-110" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ADoshxT2YIL1uXRaaqMh-4" value="" style="image;aspect=fixed;html=1;points=[];align=center;fontSize=12;image=img/lib/azure2/app_services/App_Service_Environments.svg;" vertex="1" parent="1">
          <mxGeometry x="340" y="106" width="64" height="64" as="geometry" />
        </mxCell>
        <mxCell id="ADoshxT2YIL1uXRaaqMh-5" value="Azure app service(windows)" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="450" y="-70" width="176" height="30" as="geometry" />
        </mxCell>
        <mxCell id="ADoshxT2YIL1uXRaaqMh-6" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;Preguntas:&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;5.- How many applications can you deploy to a single App Servicer Plan?&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Response: &lt;/b&gt;To the limit of the app service plan you&#39;ve chosen, which is 10 for Free, 100 for Shared, and unlimited for Basic and up.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;6.- What does ACU stand for?&lt;br&gt;Response: Azure Compute Unit.&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;br&gt;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;7.- You start the procces of creating a Windows Web App to deploy a Python application. The applications works on you local machine, but you want to ensure all the Python dependencies on your&amp;nbsp; Windows machine is also available for the web app when deployed as an App Service. What is required to get the Python app to run inside a Windows Web App?&amp;nbsp;&lt;/font&gt;&lt;/div&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Response&lt;/b&gt;: You need to configure the Runtime stack of the Intance Details when creating a web app in the Azure Portal.&lt;/font&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="270" width="600" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ADoshxT2YIL1uXRaaqMh-7" value="&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b style=&quot;&quot;&gt;Pregunta&lt;/b&gt;:&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;¿Que característica de seguridad existe para las aplicaciones API que permitirá o impedirá que las aplicaciones que se ejecutan desde otros dominios(sitios web externos) llamen a la API?&amp;nbsp;&lt;br&gt;&lt;/font&gt;&lt;div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;Respuesta: Cross-Origin Resource Sharing(CORS)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;&lt;/div&gt;&lt;div&gt;CORS es un standar con navegadores web que evitara que un sitio web llame a una API en el navegador a menos que la API permita explicitamente la llamada.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="60" y="520" width="620" height="100" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
